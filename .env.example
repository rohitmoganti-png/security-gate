# ─────────────────────────────────────────────────────────────────────────────
# Security Gate: environment variables
# 1. Copy this file:   cp .env.example .env
# 2. Fill in .env. It is gitignored and must NEVER be committed.
# 3. In GitHub, put the same values in the DEMO repo:
#    Settings → Secrets and variables → Actions
#    (secrets for keys, variables for the rest)
# ─────────────────────────────────────────────────────────────────────────────

# ---- AI reviewers (Stations 9 & 10): your own OpenAI key ----
# Use a key from a DEDICATED OpenAI project with a monthly budget cap (small blast radius).
OPENAI_API_KEY=

# Model used by the Hunter and Verifier. Cheap default; try gpt-5-mini if quality is lacking.
SECURITY_GATE_MODEL=gpt-6-luna

# ---- Gate behaviour ----
# report  = comment only, never block ("watch only" rollout phase)
# enforce = block on confirmed high/critical issues
SECURITY_GATE_MODE=enforce
